/.signal/
/definitionen/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Lokal gebaute, publizierbare Release-Ausgaben (nie aus dem Arbeitsbaum committen)
taxtronik-festwissen-*.tar.gz
taxtronik-festwissen-*.tar.gz.sha256
taxtronik-festwissen-*.tar.gz.manifest.json
taxtronik-native-*.tar.gz
taxtronik-native-*.tar.gz.sha256
taxtronik-container-v*.json
taxtronik-container-v*.json.sha256
risk-layer-release-tools.pyz
