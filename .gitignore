release-v*/

# Test / Tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Laufzeit-Ausgaben (CLI-Report; Mandantendaten – NIE einchecken, § 203 StGB)
out/
runs/
*.report.html

# Persönliche Berater-Definitionen (können mandantenbezogene Notizen enthalten)
**/personal.yaml
**/sicherungen/
festwissen_*.zip
# Norm-Kuratierung: lokaler Berater-Laufzeit-State (gemischte Scopes, pro Deployment);
# die produktive Kuratierung lebt auf der deployten Engine, auditiert im Host.
**/norm_kuratierung.yaml

# Abgleich-Zustand (gesehene RSS-Einträge)
abgleich/

# Discovery-Output (LLM-Kandidaten, Review-Queue) – Vorschläge, kein Festwissen
discovery/

# StB-Examens-Musterklausuren: urheberrechtlich geschützt ("Nur für den
# persönlichen Gebrauch"), Quelle für Gold v2 – NIE einchecken. Die abgeleiteten
# txt liegen unter discovery/ (ebenfalls ignoriert); das kuratierte Gold ist
# trainingsdaten-unabhängig (nur Query-Sätze + §-IDs) und kommt nach fixtures/gold/.
examples/klausuren/

# Mandantendaten (§ 203 StGB): die /v1-Engine ist zustandslos und schreibt diese
# Stores NICHT mehr – aber lokal vorhandene Alt-Daten dürfen NIE eingecheckt werden
# (die Daten überleben den entfernten Store-Code).
faelle/
aufgaben/

# Modelle / Engine / Indizes (Ausbaustufen, lokal, groß)
models/
engine/
# Backend-Varianten + Backups (engine_vulkan, engine_cuda, engine_hip, ...)
engine_*/
*.gguf
*.bin

# Normtext-Korpus: extern bezogene Daten + Build-Artefakte (regenerierbar via
# 'risk-layer korpus fetch' + 'risk-layer graph build'). gesetze.yaml bleibt.
corpus/gii/
corpus/*.sqlite
!corpus/gesetze.yaml

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Embedding-Index (regenerierbar via "risk-layer embedding build")
corpus/embedding/

# IDE/Tooling-Ausgaben
.VSCodeCounter/
.claude/scheduled_tasks.lock
