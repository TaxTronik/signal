# Diese Vorlage als `container-secrets.env` kopieren, auf Modus 0600 beschränken und nie
# einchecken. Der transaktionale Deployer erzeugt Repository, Digest,
# Release-ID, Git-SHA, Manifest-SHA und Festwissen-Pfad selbst; diese Werte
# dürfen hier absichtlich NICHT gesetzt werden.
RISK_LAYER_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
RISK_LAYER_DEFINITIONEN_DIR=/var/lib/risk-layer/definitionen

# Optional bei kontrollierter Token-Rotation:
# RISK_LAYER_TOKEN_VORGAENGER=

# Optional:
# RISK_LAYER_BIND_ADDRESS=127.0.0.1
# RISK_LAYER_PORT=8000
# RISK_LAYER_LLM_URL=http://llm:8080
# RISK_LAYER_MODELS_DIR=/opt/risk-layer/models
