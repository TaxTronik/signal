# systemd-Unit-Vorlage für die Risk-Layer /v1-Engine (TaxTronik).
# Wird von `deploy.sh --service` gerendert (Platzhalter ersetzt) und als
# ~/.config/systemd/user/risk-layer.service installiert. Nicht direkt verwenden.
#
# Mandantengeheimnis (§ 203 StGB): die Engine ist zustandslos und persistiert
# keine Mandantendaten; sie liest nur Festwissen (Korpus/Graph/Katalog) und
# schreibt höchstens berater-kuratierte Definitionen unter WorkingDirectory.
[Unit]
Description=Risk-Layer /v1 Engine (TaxTronik) — headless, lokal
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@WORKDIR@
# Ein aus einem benutzerschreibbaren Checkout gestarteter root-Dienst waere eine
# lokale Privilegieneskalation. deploy.sh ohne sudo erzeugt eine User-Unit; eine
# manuell installierte System-Unit muss explizit unprivilegiert konfiguriert sein.
ExecStartPre=/bin/sh -c 'if [ "$(id -u)" -eq 0 ]; then echo "Risk-Layer verweigert root: als unprivilegierte User-Unit installieren" >&2; exit 1; fi'
# Token NICHT inline (die Unit-Datei ist welt-lesbar, Default 644) — er liegt in
# einer separaten EnvironmentFile (chmod 600), gerendert von deploy.sh --service.
EnvironmentFile=@ENVFILE@
Environment="RISK_LAYER_EMB_DEVICE=@EMB_DEVICE@"
# --llm-autostart bringt Schicht 2 (llama-server) im selben Aufruf mit hoch.
# -P entfernt das benutzerschreibbare WorkingDirectory aus sys.path: gestartet
# wird das installierte Wheel, nicht zufaellig ein veraenderter Checkout.
ExecStart="@PYTHON@" -P -m risk_layer.web --host "@HOST@" --port "@PORT@" --graph corpus/graph.sqlite --llm-autostart
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RemoveIPC=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# ProtectHome/PrivateDevices/MemoryDenyWriteExecute bleiben bewusst aus:
# Arbeitsverzeichnis + Modellcache liegen oft unter $HOME, GPU-Backends brauchen
# /dev und ML-/JIT-Runtimes koennen ausfuehrbaren Speicher benoetigen.

[Install]
WantedBy=default.target
