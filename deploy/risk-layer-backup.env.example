# Als ~/.config/risk-layer/backup.env mit chmod 600 ablegen.
# Keine Shell-Syntax, keine Anführungszeichen und keine Leerzeichen in Pfaden:
# systemd EnvironmentFile/ExecStart expandiert Variablen, aber keine Shell.
PATH=/home/REPLACE/.local/bin:/usr/local/bin:/usr/bin
RISK_LAYER_RELEASE_HOME=/opt/risk-layer
RISK_LAYER_RELEASE_LAUNCHER=/opt/risk-layer/bootstrap/release-launcher.py
RISK_LAYER_BERATER_DIR=/var/lib/risk-layer/definitionen
RISK_LAYER_BACKUP_DIR=/mnt/offhost/risk-layer-backups
